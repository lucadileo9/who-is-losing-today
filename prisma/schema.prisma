// Prisma Schema per "Who Is Losing Today?"
// Configurato per PostgreSQL (compatibile sia con Supabase che DB locale)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// MODELLI UTENTI & AUTENTICAZIONE (Compatibile con NextAuth / Auth.js)
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  initials      String?
  color         String?   @default("bg-chart-1")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  dailyScores   DailyScore[]
  dailyNotes    DailyNote[]
  bugReports    BugReport[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------------------------------
// MODELLI GIOCHI & PUNTEGGI
// ------------------------------------------------------

model Game {
  id            String       @id // es: "Krilion", "Metazooa", "Chronophoto"
  name          String
  shortName     String       // es: "KR", "MZ", "CH"
  unit          String       // "pts" o "tentativi"
  isLowerBetter Boolean      @default(false)
  createdAt     DateTime     @default(now())

  dailyScores   DailyScore[]

  @@map("games")
}

model DailyScore {
  id              String   @id @default(cuid())
  userId          String
  gameId          String
  rawScore        Int      // Punteggio grezzo (es. 3129, 3)
  normalizedScore Int      // Punteggio scalato 0-100
  scoreDate       DateTime @default(now()) // Data del punteggio (YYYY-MM-DD)
  rawInputText    String?  // Testo incollato dall'utente
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId, scoreDate])
  @@map("daily_scores")
}

// ------------------------------------------------------
// MODELLO BACHECA / LAVAGNA (TEMPORANEA - 7 GIORNI)
// ------------------------------------------------------

model DailyNote {
  id          String   @id @default(cuid())
  userId      String?
  authorName  String?  @default("Giocatore")
  authorColor String?  @default("bg-chart-1")
  content     String   @db.Text
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("daily_notes")
}

// ------------------------------------------------------
// MODELLO SEGNALAZIONE BUG & FEEDBACK
// ------------------------------------------------------

model BugReport {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?
  userName    String?  @default("Ospite")
  description String   @db.Text
  pageUrl     String?
  status      String   @default("OPEN") // "OPEN", "RESOLVED", "CLOSED"
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("bug_reports")
}
