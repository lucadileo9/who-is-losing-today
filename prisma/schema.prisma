// Prisma Schema per "Who Is Losing Today?"
// Configurato per PostgreSQL (compatibile sia con Supabase che DB locale)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUM
// ------------------------------------------------------

enum Role {
  ADMIN
  PLAYER
}

enum ScoreUnit {
  POINTS
  ATTEMPTS
}

enum BugCategory {
  BUG
  UI_UX
  FEATURE
  OTHER
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  RESOLVED
  CLOSED
}

// ------------------------------------------------------
// MODELLI UTENTI, WHITELIST & AUTENTICAZIONE
// ------------------------------------------------------

model Whitelist {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())

  @@map("whitelist")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  initials      String?
  role          Role      @default(PLAYER)
  color         String    @default("#3b82f6") // Colore esadecimale per grafici (Recharts) e avatar
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  dailyScores DailyScore[]
  dailyNotes  DailyNote[]
  bugReports  BugReport[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------------------------------
// MODELLI GIOCHI & PUNTEGGI
// ------------------------------------------------------

model Game {
  id            String    @id // es: "Krilion", "Metazooa", "Chronophoto"
  name          String
  shortName     String // es: "KR", "MZ", "CH"
  unit          ScoreUnit @default(POINTS)
  color         String    @default("#10b981") // Colore iconico del gioco (Hex)
  isLowerBetter Boolean   @default(false)
  createdAt     DateTime  @default(now())

  dailyScores DailyScore[]

  @@map("games")
}

model DailyScore {
  id              String   @id @default(cuid())
  userId          String
  gameId          String
  rawScore        Int // Punteggio grezzo (es. 3129, 3)
  normalizedScore Int // Punteggio scalato 0-100
  scoreDate       DateTime @db.Date // Solo data YYYY-MM-DD: zero bug fuso orario UTC/GMT
  rawInputText    String? // Testo incollato dall'utente
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId, scoreDate])
  @@index([scoreDate, gameId])
  @@index([userId, scoreDate])
  @@map("daily_scores")
}

// ------------------------------------------------------
// MODELLO BACHECA / LAVAGNA (TEMPORANEA - 7 GIORNI)
// ------------------------------------------------------

model DailyNote {
  id        String   @id @default(cuid())
  userId    String // OBBLIGATORIO: legato all'utente autenticato
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("daily_notes")
}

// ------------------------------------------------------
// MODELLO SEGNALAZIONE BUG & FEEDBACK
// ------------------------------------------------------

model BugReport {
  id          String      @id @default(cuid())
  userId      String? // Opzionale: legato all'utente autenticato se presente
  description String      @db.Text
  category    BugCategory @default(BUG)
  priority    BugPriority @default(MEDIUM)
  status      BugStatus   @default(OPEN)
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, priority])
  @@map("bug_reports")
}
